tyId\n    }\n":o.PreviewModalRateableGameFragmentDoc,"\n    mutation PreviewModalEntitySetThumbs(\n        $entityId: ID!\n        $rating: ThumbRating!\n        $trackId: Int\n    ) {\n        setEntityThumbRating(\n            input: { entityId: $entityId, rating: $rating, trackId: $trackId }\n        ) {\n            entity {\n                ... on Video {\n                    videoId\n\n                    thumbRating: thumbRatingV2\n                }\n                ... on Game {\n                    gameId\n                    gameThumbRating: thumbRating\n                }\n            }\n        }\n    }\n":o.PreviewModalEntitySetThumbsDocument,"\n    query DetailModal(\n        $unifiedEntityId: ID!\n        $videoMerchEnabled: Boolean!\n        $hasPromoVideoOverride: Boolean!\n        $fetchPromoVideoOverride: Boolean!\n        $promoVideoId: Int!\n        $isLiveEpisodic: Boolean!\n        $videoMerchContext: PromoVideoUiContext!\n        $textEvidenceUiContext: TextEvidenceUiContext!\n        $artworkContext: ArtworkContext!\n        $opaqueImageFormat: ArtworkFormat\n        $transparentImageFormat: ArtworkFormat\n    ) {\n        unifiedEntities(unifiedEntityIds: [$unifiedEntityId]) {\n            ...PreviewModalDetailModal\n            ...PreviewModalMerchPlayer\n        }\n\n        promoVideos: videos(videoIds: [$promoVideoId])\n            @include(if: $fetchPromoVideoOverride) {\n            videoId\n            ...PreviewModalPromoOverrides\n        }\n    }\n":o.DetailModalDocument,"\n    query MiniModalQuery(\n        $unifiedEntityIds: [ID!]!\n        $videoMerchEnabled: Boolean!\n        $hasPromoVideoOverride: Boolean!\n        $fetchPromoVideoOverride: Boolean!\n        $promoVideoId: Int!\n        $isLiveEpisodic: Boolean!\n        $videoMerchContext: PromoVideoUiContext!\n        $textEvidenceUiContext: TextEvidenceUiContext!\n        $artworkContext: ArtworkContext!\n        $opaqueImageFormat: ArtworkFormat\n        $transparentImage