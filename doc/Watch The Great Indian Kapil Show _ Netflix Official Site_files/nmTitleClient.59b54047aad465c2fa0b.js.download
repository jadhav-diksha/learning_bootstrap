 SDP\n                dimension: { width: 342, height: 192 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STILL\n                    enableLockBadgeChecks: true\n                    preferNonWebpForOriginals: true\n                }\n            }\n            context: $artworkContext\n        ) {\n            ...Artwork\n        }\n    }\n":o.PreviewModalArtworkBoxartFragmentDoc,"\n    fragment PreviewModalArtworkBoxartHighRes on Video {\n        videoId\n        boxartHighRes: artworkExtended(\n            params: {\n                artworkType: SDP\n                format: $opaqueImageFormat\n                dimension: { width: 665, height: 375 }\n                features: {\n                    fallbackStrategy: STILL\n                    preferNonWebpForOriginals: true\n                    enableLockBadgeChecks: true\n                }\n            }\n            context: $artworkContext\n        ) {\n            ...Artwork\n        }\n    }\n":o.PreviewModalArtworkBoxartHighResFragmentDoc,"\n    fragment PreviewModalArtworkGameBoxart on Game {\n        gameId\n        boxart: artworkExtended(\n            params: {\n                artworkType: SDP\n                dimension: { width: 342, height: 192 }\n                format: $opaqueImageFormat\n                features: {\n                    fallbackStrategy: STILL\n                    enableLockBadgeChecks: true\n                    preferNonWebpForOriginals: true\n                }\n            }\n            context: $artworkContext\n        ) {\n            ...Artwork\n        }\n    }\n":o.PreviewModalArtworkGameBoxartFragmentDoc,"\n    fragment PreviewModalArtworkGameBoxartHighRes on Game {\n        gameId\n        boxartHighRes: artworkExtended(\n            params: {\n                artworkType: SDP\n                format: $opaqueImageFormat\n                dimension: { width: 665, height: 375 }\n                features: {\n    